{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Release Package Script Settings",
  "description": "Invoke-ReleasePackage.ps1 plugin settings. Place ReleasePublishGuard before GitHub/DotNetNuGet. Publish plugins omit per-plugin branches. Semver comes from DotNetReleaseVersion (projectFiles). DotNetPack packs the first projectFiles entry only, so each library is packed and pushed as its own pair.",
  "repoUtilsSecretsShared": "RepoUtilsSecretsShared",
  "repoUtilsSecrets": "RepoUtilsSecrets",
  "plugins": [
    {
      "name": "DotNetReleaseVersion",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Core.Desktop\\MaksIT.Core.Desktop.csproj"
      ]
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "failOnVulnerabilities": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Core.Desktop\\MaksIT.Core.Desktop.csproj",
        "..\\..\\..\\src\\MaksIT.Core.UI\\MaksIT.Core.UI.csproj"
      ]
    },
    {
      "name": "ReleasePublishGuard",
      "stageLabel": "release",
      "enabled": true,
      "branches": [
        "main"
      ],
      "requireExactTagOnHead": true,
      "tagVersionMustMatchDotNetRelease": true,
      "whenRequirementsNotMet": "skip",
      "requireCleanWorkingTree": false,
      "ensureTagOnRemote": true,
      "remoteName": "origin"
    },
    {
      "name": "DotNetPack",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Core.Desktop\\MaksIT.Core.Desktop.csproj"
      ],
      "artifactsDir": "..\\..\\..\\releases"
    },
    {
      "name": "DotNetNuGet",
      "stageLabel": "release",
      "enabled": true,
      "nugetSecret": "NuGet",
      "source": "https://api.nuget.org/v3/index.json"
    },
    {
      "name": "DotNetPack",
      "stageLabel": "build",
      "enabled": true,
      "projectFiles": [
        "..\\..\\..\\src\\MaksIT.Core.UI\\MaksIT.Core.UI.csproj"
      ],
      "artifactsDir": "..\\..\\..\\releases"
    },
    {
      "name": "DotNetNuGet",
      "stageLabel": "release",
      "enabled": true,
      "nugetSecret": "NuGet",
      "source": "https://api.nuget.org/v3/index.json"
    },
    {
      "name": "AttachNuGetPackages",
      "stageLabel": "release",
      "enabled": true,
      "artifactsDir": "..\\..\\..\\releases"
    },
    {
      "name": "GitHub",
      "stageLabel": "release",
      "enabled": true,
      "githubSecret": "GitClone",
      "repository": "https://github.com/MAKS-IT-COM/maksit-core-ui",
      "releaseNotesFile": "..\\..\\..\\CHANGELOG.md",
      "releaseTitlePattern": "Release {version}"
    },
    {
      "name": "CleanupArtifacts",
      "stageLabel": "release",
      "enabled": true,
      "includePatterns": [
        "*.nupkg",
        "*.snupkg"
      ]
    }
  ]
}
