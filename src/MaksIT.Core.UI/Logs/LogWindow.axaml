<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaksIT.Core.UI.Logs"
        x:Class="MaksIT.Core.UI.Logs.LogWindow"
        x:DataType="vm:LogViewModel"
        Width="860"
        Height="560"
        MinWidth="560"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <TextBlock Text="{Binding CopyStatus}"
                 Opacity="0.7"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0" />
      <Button Content="{Binding CopyLabel}" Click="OnCopyClick" />
      <Button Content="{Binding CloseLabel}"
              Click="OnCloseClick"
              Padding="16,8"
              IsDefault="True"
              IsCancel="True" />
    </StackPanel>
    <ComboBox DockPanel.Dock="Top"
              ItemsSource="{Binding Files}"
              SelectedItem="{Binding SelectedFile}"
              Margin="0,0,0,12" />
    <TextBox Text="{Binding Report}"
             FontFamily="Cascadia Mono, Consolas, Ubuntu Mono, monospace"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
