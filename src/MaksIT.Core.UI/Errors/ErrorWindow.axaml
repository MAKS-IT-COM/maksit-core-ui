<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaksIT.Core.UI.Errors"
        x:Class="MaksIT.Core.UI.Errors.ErrorWindow"
        x:DataType="vm:ErrorReportViewModel"
        Width="720"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        CanResize="True"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <TextBlock Text="{Binding CopyStatus}"
                 Opacity="0.7"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0" />
      <Button Content="{Binding Text.CopyLabel}" Command="{Binding CopyCommand}" />
      <Button Content="{Binding Text.CloseLabel}"
              Command="{Binding CloseCommand}"
              Padding="16,8"
              IsDefault="True"
              IsCancel="True" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Text.Hint}"
               Opacity="0.75"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />
    <TextBox Text="{Binding Report}"
             FontFamily="Cascadia Mono, Consolas, Ubuntu Mono, monospace"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
