<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="using:MaksIT.Core.Desktop"
        xmlns:vm="using:MaksIT.Core.UI.WhatsNew"
        x:Class="MaksIT.Core.UI.WhatsNew.WhatsNewWindow"
        x:DataType="vm:WhatsNewViewModel"
        Title="What's new"
        Width="520"
        MaxHeight="640"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0" ColumnDefinitions="*,Auto">
      <CheckBox Content="Do not show again"
                IsChecked="{Binding DoNotShowAgain}"
                VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Content="Close"
              Click="OnCloseClick"
              Padding="12,7"
              IsDefault="True"
              IsCancel="True" />
    </Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="4">
        <TextBlock Text="What's new" FontSize="20" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="desktop:ReleaseNote">
              <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Added}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
